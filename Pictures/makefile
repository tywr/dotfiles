montblanc:
	topowall fetch --center 45.859113730128804,6.935712956693951 --width-km 80 --size 2880x1800 -o topos/montblanc/topo.topo
	topowall render topos/montblanc/topo.topo -o Wallpapers/montblanc.png --theme montblanc/topo-theme.toml

alps:
	topowall fetch --center 46.40,10.23 --width-km 1000 --size 2880x1800 -o topos/alps/topo.topo
	topowall render topos/alps/topo.topo -o Wallpapers/alps.png --theme topos/alps/topo-theme.toml
