#!/usr/bin/env python
"""docker-compose build, but with Apple's native `container`.

Tags the image as the service name, resolves build context/dockerfile, and
forwards compose build.args plus any extra flags (e.g. --build-arg K=V).

Usage: container-compose-build [-f compose.yml] SERVICE [--build-arg K=V ...]
"""
import shlex
import subprocess
import sys

from container_compose import build_args, image_tag, load_service, resolve

USAGE = "usage: container-compose-build [-f file] SERVICE [--build-arg K=V ...]"


def main(argv):
    base, name, service, rest = load_service(argv, USAGE)

    build = service.get("build", ".")
    if isinstance(build, dict):
        context = build.get("context", ".")
        dockerfile = build.get("dockerfile")
        args_spec = build.get("args")
    else:  # short syntax: build is the context path
        context, dockerfile, args_spec = build, None, None

    cmd = ["container", "build", "-t", image_tag(name)]
    if dockerfile:
        cmd += ["-f", dockerfile]  # compose passes this relative to cwd
    for a in build_args(args_spec):
        cmd += ["--build-arg", a]
    cmd += rest
    cmd.append(resolve(base, context))

    # Keep the previous build under a temp tag, then delete only that tag so its
    # orphaned blobs get freed. `image prune` would also drop the BuildKit image.
    previous = f"{image_tag(name)}:previous"
    had_previous = subprocess.run(
        ["container", "image", "tag", image_tag(name), previous],
        capture_output=True,
    ).returncode == 0

    print("+ " + shlex.join(cmd), file=sys.stderr)
    status = subprocess.run(cmd).returncode
    if had_previous:
        subprocess.run(["container", "image", "delete", previous], check=False)
    if status != 0:
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
