#!/usr/bin/env python
"""docker-compose run, but with Apple's native `container`.

Runs the image named after the service and translates short-syntax volume
mounts to -v flags (relative host paths resolve against the compose file dir).

Usage: container-compose-run [-f compose.yml] [-b|--build] SERVICE [CMD...]
"""
import argparse
import os
import subprocess
import sys

from container_compose import open_service, publish_specs, resolve, run


def main(argv):
    p = argparse.ArgumentParser(prog="container-compose-run")
    p.add_argument("-f", "--file", default="docker-compose.yml", help="compose file")
    p.add_argument("-m", "--memory", help="override memory limit")
    p.add_argument("-c", "--cpus", help="override CPU limit")
    p.add_argument("-b", "--build", action="store_true", help="build the image before running")
    p.add_argument("--entrypoint", help="override the image entrypoint")
    p.add_argument("service")
    p.add_argument("cmd", nargs=argparse.REMAINDER, help="command to run in the container")
    args = p.parse_args(argv)

    base, service = open_service(args.file, args.service)
    name, cmd_args = args.service, args.cmd

    if args.build:
        builder = os.path.join(os.path.dirname(__file__), "container-compose-build")
        result = subprocess.run([builder, "-f", args.file, name])
        if result.returncode:
            sys.exit(result.returncode)

    cmd = ["container", "run", "--rm"]
    for vol in service.get("volumes") or []:
        # ponytail: short syntax only ("host:container[:mode]" / "named:container");
        #           add long-syntax dict support when a compose file needs it.
        host, sep, rest = str(vol).partition(":")
        if sep and host[:1] in "./~":  # bind mount -> resolve host path
            vol = f"{resolve(base, host)}:{rest}"
        cmd += ["-v", vol]
    for spec in publish_specs(service.get("ports")):
        cmd += ["-p", spec]
    env_file = service.get("env_file")
    for f in [env_file] if isinstance(env_file, (str, dict)) else (env_file or []):
        path = f["path"] if isinstance(f, dict) else f  # long syntax: {path, required}
        cmd += ["--env-file", resolve(base, path)]
    # resource limits: CLI flag wins, else v3 deploy.resources.limits, else v2 keys
    limits = (((service.get("deploy") or {}).get("resources") or {}).get("limits")) or {}
    memory = args.memory or limits.get("memory", service.get("mem_limit"))
    cpus = args.cpus or limits.get("cpus", service.get("cpus"))
    if memory:
        cmd += ["-m", str(memory)]
    if cpus:
        cmd += ["-c", str(cpus)]
    # entrypoint: CLI flag wins over compose. container --entrypoint takes one cmd;
    # extra tokens from a compose list become leading command args.
    entrypoint = args.entrypoint or service.get("entrypoint")
    if isinstance(entrypoint, list):
        entrypoint, extra = (entrypoint[0], entrypoint[1:]) if entrypoint else (None, [])
        cmd_args = extra + cmd_args
    if entrypoint:
        cmd += ["--entrypoint", entrypoint]
    cmd.append(name)  # image == service name
    cmd += cmd_args

    run(cmd)


if __name__ == "__main__":
    main(sys.argv[1:])
