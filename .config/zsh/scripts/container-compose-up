#!/usr/bin/env python
"""docker-compose up for one service, using Apple's native `container`."""
import argparse
import os
import subprocess
import sys


def main():
    p = argparse.ArgumentParser(prog="container-compose-up")
    p.add_argument("-f", "--file", default="docker-compose.yml", help="compose file")
    p.add_argument("-b", "--build", action="store_true", help="build the image before starting")
    p.add_argument("service")
    args = p.parse_args()

    runner = os.path.join(os.path.dirname(__file__), "container-compose-run")
    cmd = [
        runner,
        "-f",
        args.file,
        "--name",
        args.service,
    ]
    if args.build:
        cmd.append("--build")
    cmd.append(args.service)

    process = subprocess.Popen(cmd)
    try:
        returncode = process.wait()
    except KeyboardInterrupt:
        subprocess.run(["container", "stop", args.service])
        returncode = process.wait()
    sys.exit(returncode)


if __name__ == "__main__":
    main()
