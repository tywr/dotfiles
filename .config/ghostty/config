term = xterm-ghostty
working-directory = /Users/tywr
window-inherit-working-directory = false
background-opacity = 0.95
background-blur = 100

theme = /Users/tywr/.config/colorthemes/ghostty/gravity
palette-generate = true
palette-harmonious = true
font-size = 17.5
# font-size = 10

font-family = "Nordwand Mono"
font-style = "Retina"
font-style-italic = "Retina Italic"
font-feature = ss02,cv11=2,dlig,ss03,cv01=2

# font-feature = cv06,cv12,cv14,cv20,ss20


adjust-cursor-thickness = 4
cursor-style-blink = false

macos-non-native-fullscreen = true
macos-titlebar-style = hidden
window-vsync = true

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

mouse-hide-while-typing = true

copy-on-select = true
confirm-close-surface = false

shell-integration = zsh
macos-icon = custom-style
macos-icon-ghost-color = #88c0d0

scrollback-limit = 1000000
link-previews = false
adjust-underline-position = 7%

keybind = cmd+shift+space=text:fzf\x0d
