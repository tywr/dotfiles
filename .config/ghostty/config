term = xterm-256color
working-directory = /Users/tywr
window-inherit-working-directory = false
background-opacity = 0.95
background-blur = 100

theme = /Users/tywr/.config/colorthemes/ghostty/gravity
palette-generate = true
palette-harmonious = true
font-size = 18

# font-family = "SF Mono"
# font-family = "Berkeley Mono Trial"
# font-family = "Klartext Mono Code"
# font-size = 20
# font-family = "Lilex"
# font-feature = cv02
font-family = "Nordwand Mono"
# font-style-italic = "ExtraLight"
font-style-bold = "Bold"
font-style-bold-italic = false

# font-feature = cv03

adjust-cursor-thickness = 4
cursor-style-blink = true

# window-decoration = auto
macos-titlebar-style = hidden

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

mouse-hide-while-typing = true

window-vsync = true

copy-on-select = true
confirm-close-surface = false

shell-integration = zsh
macos-icon = custom-style
macos-icon-ghost-color = #88c0d0

scrollback-limit = 1000000
link-previews = false
adjust-underline-position = 7%
