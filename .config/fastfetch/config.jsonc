{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/Users/tywr/.config/assets/icon.png",
    "width": 19,
    "height": 9,
    "padding": {
      "right": 5,
      "left": 5,
    },
    "preserveAspectRatio": true
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "33"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "Os >",
      "format": "{2} {8} {11} {12}"
    },
    {
      "type": "host",
      "key": "Ho >",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": "Sh >"
    },
    {
      "type": "display",
      "key": "Re >",
      "compactType": "scaled"
    },
    {
      "type": "de",
      "key": "De >"
    },
    {
      "type": "wm",
      "key": "Wm >"
    },
    {
      "type": "theme",
      "key": "Th >"
    },
    {
      "type": "terminal",
      "key": "Te >"
    },
    {
      "type": "terminalfont",
      "key": "Fo >"
    },
    {
      "type": "memory",
      "key": "Me >",
      "format": "{1} / {2}"
    }
  ]
}
